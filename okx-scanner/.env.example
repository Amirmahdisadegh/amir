# --- Telegram (needed for alerts) ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# --- OKX API (ONLY needed for Mode 2 / live execution) ---
# SECURITY REQUIREMENTS for this key on the OKX panel:
#   * Permission: "Trade" ONLY.  Withdrawal MUST be disabled.
#   * IP whitelist: 206.245.166.128 (your server) only.
#   * Start with a key scoped to OKX Demo Trading.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
